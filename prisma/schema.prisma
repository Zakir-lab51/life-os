// LIFE OS relational model: PLANNED for Phase 4 (accounts + cloud sync).
//
// Phase 1 runs entirely in the browser (IndexedDB via Dexie, see
// src/lib/db/db.ts). This schema mirrors those records so the same ids and
// timestamps can be synced to PostgreSQL later. Prisma is NOT installed yet;
// nothing reads this file at runtime.
//
// Conventions: string ids generated client-side (stable across devices),
// createdAt/updatedAt on every mutable row, soft limits enforced by the Zod
// schemas in src/lib/validation/schemas.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  preferences   UserPreference?
  tasks         Task[]
  projects      Project[]
  goals         Goal[]
  habits        Habit[]
  events        CalendarEvent[]
  focusSessions FocusSession[]
  notes         Note[]
  subjects      Subject[]
  transactions  Transaction[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  activity      ActivityEvent[]
  reflections   Reflection[]
}

model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Prefs record from the client, validated by prefsSchema.
  data      Json
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum Area {
  work
  study
  health
  mind
  personal
  finance
}

model Task {
  id           String     @id
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goalId       String?
  goal         Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title        String
  notes        String     @default("")
  status       TaskStatus @default(todo)
  /// 1 = urgent … 4 = low
  priority     Int        @default(3)
  area         Area       @default(work)
  tags         String[]
  dueDate      DateTime?  @db.Date
  dueTime      String?
  reminderAt   DateTime?
  estimateMin  Int        @default(30)
  /// { freq, interval, weekdays? } or null
  recurrence   Json?
  seriesId     String?
  order        Float      @default(0)
  completedAt  DateTime?
  createdAt    DateTime
  updatedAt    DateTime
  subtasks     Subtask[]
  dependsOn    TaskDependency[] @relation("dependent")
  dependents   TaskDependency[] @relation("prerequisite")

  @@index([userId, status, dueDate])
  @@index([userId, completedAt])
}

model Subtask {
  id     String  @id
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)
}

model TaskDependency {
  taskId         String
  task           Task   @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Task   @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([taskId, prerequisiteId])
}

model Project {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  deadline    DateTime? @db.Date
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  tasks       Task[]
}

enum GoalHorizon {
  weekly
  monthly
  quarterly
  yearly
  five_year
}

model Goal {
  id          String      @id
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  horizon     GoalHorizon
  area        Area
  targetValue Float?
  unit        String?
  deadline    DateTime?   @db.Date
  createdAt   DateTime
  updatedAt   DateTime
  milestones  Milestone[]
  tasks       Task[]
}

model Milestone {
  id        String    @id
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime? @db.Date
  doneAt    DateTime?
}

model Habit {
  id         String     @id
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  icon       String
  color      String
  area       Area
  /// { kind: "daily" } | { kind: "weekdays", days } | { kind: "weekly", times }
  schedule   Json
  timeOfDay  String
  startDate  DateTime   @db.Date
  order      Int
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime
  logs       HabitLog[]
}

model HabitLog {
  /// `${habitId}:${date}`: one check-in per habit per day
  id        String   @id
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime

  @@unique([habitId, date])
}

/// Time blocks on the planner (events, tasks, focus, breaks, routines).
model CalendarEvent {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  /// minutes after midnight
  start     Int
  end       Int
  title     String
  kind      String
  taskId    String?
  notes     String   @default("")
  source    String   @default("manual")
  createdAt DateTime
  updatedAt DateTime

  @@index([userId, date])
}

model FocusSession {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String
  date       DateTime @db.Date
  startedAt  DateTime
  endedAt    DateTime
  plannedSec Int?
  actualSec  Int
  taskId     String?
  area       Area?
  completed  Boolean

  @@index([userId, date])
}

model Reflection {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mood      Int
  wins      String   @default("")
  improve   String   @default("")
  createdAt DateTime
  updatedAt DateTime

  @@id([userId, date])
}

model Note {
  id        String     @id
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  folder    String?
  tags      String[]
  pinned    Boolean    @default(false)
  createdAt DateTime
  updatedAt DateTime
  linksFrom NoteLink[] @relation("from")
  linksTo   NoteLink[] @relation("to")
}

model NoteLink {
  fromId String
  from   Note   @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Note   @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model Subject {
  id         String      @id
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  examDate   DateTime?   @db.Date
  createdAt  DateTime
  flashcards Flashcard[]
  quizzes    QuizAttempt[]
}

model Flashcard {
  id        String   @id
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  front     String
  back      String
  /// spaced-repetition state
  ease      Float    @default(2.5)
  interval  Int      @default(0)
  dueDate   DateTime @db.Date
  createdAt DateTime
  reviews   Review[]
}

model Review {
  id          String    @id
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  grade       Int
  reviewedAt  DateTime
}

model QuizAttempt {
  id        String   @id
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  takenAt   DateTime
}

model Transaction {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// minor units (paise for INR) to avoid floating-point money
  amount    Int
  currency  String   @default("INR")
  kind      String
  category  String
  note      String   @default("")
  date      DateTime @db.Date
  recurring Json?
  createdAt DateTime

  @@index([userId, date])
}

model Budget {
  id       String @id
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  month    String
  limit    Int
}

model SavingsGoal {
  id       String    @id
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  target   Int
  saved    Int       @default(0)
  deadline DateTime? @db.Date
}

model ActivityEvent {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  at        DateTime
  title     String
  refId     String?
  area      Area?
  /// unique per user: repeating an action never creates a second event
  dedupeKey String

  @@unique([userId, dedupeKey])
  @@index([userId, at])
}
